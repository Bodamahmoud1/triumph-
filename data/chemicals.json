[
  {
    "id": "hypo",
    "theme": "gold",
    "name": "Hypo",
    "code": "4AL1",
    "type_ar": "مبيض كلور للغسيل",
    "raw_content": "\r\n\r\n          <div class=\"card-header hd-theme\">\r\n            <div class=\"clax-badge-wrap\">\r\n              <div class=\"clax-box\"><span>CLAX</span></div>\r\n              <div class=\"clax-divider\"></div>\r\n              <span class=\"card-prod-name\">Hypo</span>\r\n            </div>\r\n            <span class=\"card-prod-code\">4AL1</span>\r\n          </div>\r\n\r\n          <span class=\"prod-type-tag tag-theme\">مبيض كلور للغسيل</span>\r\n\r\n          <div class=\"card-body\">\r\n            <div class=\"card-top-row\">\r\n\r\n              <div class=\"card-content\">\r\n                <div class=\"sec-head head-theme\">إيه هي المادة دي؟</div>\r\n                <p class=\"btext\">Clax Hypo هو مبيض كلور للغسيل في المغاسل الكبيرة والمستشفيات. يُضاف في وقت الشطف على\r\n                  حرارة بين 20 و40 درجة. يصلح للغسيل الأبيض وبعض الملونات اللي تتحمل الكلور.</p>\r\n\r\n                <div class=\"sec-head head-theme\">إزاي بيشتغل؟</div>\r\n                <p class=\"btext\">فيه كلور وقلويات بتساعد على التبييض على حرارة منخفضة. سائل رقيق سهل الضخ. يصلح للغسيل\r\n                  الأبيض وللقطع اللي تتحمل الكلور زي أغطية غرف العمليات.</p>\r\n\r\n                <div class=\"sec-head head-theme\">المميزات</div>\r\n                <ul class=\"blist\">\r\n                  <li>مبيض ممتاز لكل الغسيل الأبيض</li>\r\n                  <li>سهل الجرعة</li>\r\n                  <li>بيحافظ على الغسيل لو اتستخدم صح</li>\r\n                  <li>بيبيض على حرارة قليلة = توفير في الكهرباء</li>\r\n                  <li>بيعمل نظافة كويسة للغسيل</li>\r\n                </ul>\r\n              </div>\r\n\r\n              <div class=\"card-icon-box\">\r\n                <svg viewBox=\"0 0 80 70\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                  <rect x=\"5\" y=\"5\" width=\"70\" height=\"60\" rx=\"4\" stroke=\"#555\" stroke-width=\"2.2\" fill=\"#fff\" />\r\n                  <rect x=\"5\" y=\"5\" width=\"70\" height=\"13\" rx=\"4\" fill=\"#e2e2e2\" stroke=\"#555\" stroke-width=\"2.2\" />\r\n                  <circle cx=\"52\" cy=\"11.5\" r=\"3\" fill=\"#2b52a8\" />\r\n                  <circle cx=\"62\" cy=\"11.5\" r=\"3\" fill=\"#c8a96e\" />\r\n                  <rect x=\"14\" y=\"8.5\" width=\"22\" height=\"5\" rx=\"1.5\" fill=\"#ccc\" />\r\n                  <circle cx=\"40\" cy=\"42\" r=\"20\" stroke=\"#555\" stroke-width=\"2.2\" fill=\"#eef5ff\" />\r\n                  <circle cx=\"40\" cy=\"42\" r=\"13\" stroke=\"#888\" stroke-width=\"1.3\" fill=\"none\" />\r\n                  <circle cx=\"40\" cy=\"42\" r=\"4\" fill=\"#666\" />\r\n                  <circle cx=\"40\" cy=\"42\" r=\"2\" fill=\"#999\" />\r\n                  <path d=\"M30 41 Q34 38 38 41 Q42 44 46 41 Q49 38 50 41\" stroke=\"#2b52a8\" stroke-width=\"0.9\"\r\n                    fill=\"none\" opacity=\"0.55\" />\r\n                  <path d=\"M30 45 Q34 42 38 45 Q42 48 46 45 Q49 42 50 45\" stroke=\"#2b52a8\" stroke-width=\"0.9\"\r\n                    fill=\"none\" opacity=\"0.4\" />\r\n                  <path d=\"M23 33 A19 19 0 0 1 40 23\" stroke=\"#555\" stroke-width=\"1.5\" fill=\"none\"\r\n                    stroke-linecap=\"round\" marker-end=\"url(#arr-gray)\" />\r\n                  <path d=\"M57 51 A19 19 0 0 1 40 61\" stroke=\"#555\" stroke-width=\"1.5\" fill=\"none\"\r\n                    stroke-linecap=\"round\" marker-end=\"url(#arr-gray)\" />\r\n                  <path d=\"M38 54 Q37 57 38 59 Q39 61 40 59 Q41 57 40 54Z\" fill=\"#2b52a8\" opacity=\"0.35\" />\r\n                </svg>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"sec-head head-theme\" style=\"margin-top:10px;\">طريقة الاستخدام والجرعة</div>\r\n            <p class=\"dosage-line\">الجرعة بتتغير على حسب نوع الغسيل. المناسبة: 6 – 15 مل / كجم غسيل جاف.</p>\r\n            <p class=\"note-head\">مهم جداً اتبع التعليمات دي:</p>\r\n            <ul class=\"blist\">\r\n              <li>أحسن نتيجة وأقل ضرر: حرارة الماء حوالي 28 درجة، والـ pH حوالي 9.5.</li>\r\n              <li>لو الـ pH نزل تحت 9.5 الكلور بيبقى أقوى وبيتلف الغسيل.</li>\r\n              <li>لو الـ pH عالي، ممكن ترفع الحرارة — عند pH 10.5 الحرارة تبقى 50-55 درجة.</li>\r\n              <li>الكلور مع الكلورهيكسيدين بيعمل بقع بنية صعب تتشال.</li>\r\n              <li>بعد التبييض لازم تحيد الكلور الزيادة في آخر شطفة (Clax سيد).</li>\r\n              <li>ماتستخدمش Hypo على النايلون (زي حصائر HTN).</li>\r\n            </ul>\r\n          </div>\r\n\r\n          <div class=\"tech-section\">\r\n            <div class=\"sec-head head-theme\">البيانات الفنية</div>\r\n            <table class=\"tech-table-enhanced tt-theme\">\r\n              <thead>\r\n                <tr>\r\n                  <th colspan=\"4\">البيانات الفنية</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr>\r\n                  <td class=\"lbl\">الشكل</td>\r\n                  <td class=\"val\">سائل أصفر شفاف</td>\r\n                  <td class=\"lbl\">الـ pH (محلول 1%)</td>\r\n                  <td class=\"val\">11.8</td>\r\n                </tr>\r\n                <tr>\r\n                  <td class=\"lbl\">الكثافة (20°م)</td>\r\n                  <td class=\"val\">1.175</td>\r\n                  <td class=\"lbl\">الكلور المتاح (%)</td>\r\n                  <td class=\"val\">8.34</td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n            <p class=\"tech-note\">الأرقام مؤشرات عامة للإنتاج العادي وليست مواصفة رسمية.</p>\r\n          </div>\r\n\r\n          <div class=\"card-safe safe-body-theme\">\r\n            <span class=\"card-safe-head safe-theme\">التخزين والتداول الآمن</span>\r\n            <p class=\"card-safe-text\">يُحفظ في العبوة الأصلية مغلقة بعيد عن الحرارة الشديدة. محتاج معلومات أكتر؟ راجع\r\n              ورقة بيانات السلامة (SDS).</p>\r\n          </div>\r\n        "
  },
  {
    "id": "soft",
    "theme": "pink",
    "name": "Soft Extra",
    "code": "5DL2",
    "type_ar": "منعم أقمشة مركز",
    "raw_content": "\r\n\r\n          <div class=\"card-header hd-theme\">\r\n            <div class=\"clax-badge-wrap\">\r\n              <div class=\"clax-box\"><span>CLAX</span></div>\r\n              <div class=\"clax-divider\"></div>\r\n              <span class=\"card-prod-name\">Soft Extra</span>\r\n            </div>\r\n            <span class=\"card-prod-code\">5DL2</span>\r\n          </div>\r\n\r\n          <span class=\"prod-type-tag tag-theme\">منعم أقمشة مركز</span>\r\n\r\n          <div class=\"card-body\">\r\n            <div class=\"card-top-row\">\r\n\r\n              <div class=\"card-content\">\r\n                <div class=\"sec-head head-theme\">إيه هي المادة دي؟</div>\r\n                <p class=\"btext\">Clax Soft Extra منعم أقمشة مركز للمغاسل الكبيرة والداخلية. يصلح لمعظم أنواع الغسيل\r\n                  ويتضاف يدوي أو بالماكينة.</p>\r\n\r\n                <div class=\"sec-head head-theme\">المميزات</div>\r\n                <ul class=\"blist\">\r\n                  <li>بينعم أنواع كتير (مناشف، شراشف، صوف وغيرها)</li>\r\n                  <li>بيمنع الكهرباء الساكنة في الأقمشة الصناعية</li>\r\n                  <li>بيدي رائحة حلوة بتفضل على الغسيل</li>\r\n                  <li>مكوناته قابلة للتحلل وصديقة للبيئة</li>\r\n                </ul>\r\n\r\n                <div class=\"sec-head head-theme\">إزاي بيشتغل؟</div>\r\n                <p class=\"btext\">بيلتصق بخيوط القماش فيخليه ناعم ومريح. في التجفيف بيمنع تشابك الخيوط وتراكم الكهرباء\r\n                  الساكنة. يصلح بصفة خاصة للقطع التقيلة زي المناشف.</p>\r\n              </div>\r\n\r\n              <div class=\"card-icon-box\">\r\n                <svg viewBox=\"0 0 80 70\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                  <rect x=\"8\" y=\"6\" width=\"64\" height=\"58\" rx=\"10\" stroke=\"#c22882\" stroke-width=\"2.2\" fill=\"#fdf0f8\" />\r\n                  <ellipse cx=\"40\" cy=\"36\" rx=\"20\" ry=\"22\" fill=\"#2b52a8\" opacity=\"0.88\" />\r\n                  <path d=\"M24 34 Q30 28 36 34 Q42 40 48 34 Q54 28 56 34\" stroke=\"#fff\" stroke-width=\"1.8\" fill=\"none\"\r\n                    opacity=\"0.7\" stroke-linecap=\"round\" />\r\n                  <path d=\"M26 40 Q32 34 38 40 Q44 46 50 40 Q54 36 56 40\" stroke=\"#fff\" stroke-width=\"1.4\" fill=\"none\"\r\n                    opacity=\"0.5\" stroke-linecap=\"round\" />\r\n                  <circle cx=\"30\" cy=\"22\" r=\"4.5\" stroke=\"#c22882\" stroke-width=\"1.8\" fill=\"none\" />\r\n                  <circle cx=\"52\" cy=\"18\" r=\"3\" stroke=\"#c22882\" stroke-width=\"1.5\" fill=\"none\" />\r\n                  <circle cx=\"22\" cy=\"48\" r=\"2.5\" stroke=\"#c22882\" stroke-width=\"1.3\" fill=\"none\" />\r\n                  <circle cx=\"58\" cy=\"48\" r=\"1.8\" fill=\"#c22882\" opacity=\"0.6\" />\r\n                  <circle cx=\"20\" cy=\"20\" r=\"1.5\" fill=\"#c22882\" opacity=\"0.5\" />\r\n                </svg>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"sec-head head-theme\" style=\"margin-top:10px;\">طريقة الاستخدام والجرعة</div>\r\n            <p class=\"btext\">يُضاف في آخر شطفة في الغسالة أو في آخر قسم في ماكينة الغسيل المستمرة.</p>\r\n            <p class=\"btext\" style=\"margin-top:3px;\"><strong>الجرعة:</strong> 1.5 – 5.0 مل / كجم غسيل جاف.</p>\r\n            <p class=\"btext\" style=\"margin-top:4px;\">ماتستخدمهوش على:</p>\r\n            <ul class=\"blist\" style=\"margin-top:2px;\">\r\n              <li>ملابس الغرف النظيفة (مصنوعة من بوليستر دقيق)</li>\r\n              <li>الغسيل المعالج بمادة طاردة للماء أو مناديل التنظيف الدقيقة</li>\r\n            </ul>\r\n          </div>\r\n\r\n          <div class=\"tech-section\">\r\n            <div class=\"sec-head head-theme\">البيانات الفنية</div>\r\n            <table class=\"tech-table-enhanced tt-theme\">\r\n              <thead>\r\n                <tr>\r\n                  <th colspan=\"4\">البيانات الفنية</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr>\r\n                  <td class=\"lbl\">الشكل</td>\r\n                  <td class=\"val\">سائل أزرق رقيق</td>\r\n                  <td class=\"lbl\">الـ pH (نقي)</td>\r\n                  <td class=\"val\">2.85</td>\r\n                </tr>\r\n                <tr>\r\n                  <td class=\"lbl\">الكثافة عند 20°م</td>\r\n                  <td class=\"val\">0.994</td>\r\n                  <td class=\"lbl\">اللزوجة (mPa.s / 25°م)</td>\r\n                  <td class=\"val\">30-40</td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n            <p class=\"tech-note\">الأرقام مؤشرات عامة للإنتاج العادي وليست مواصفة رسمية.</p>\r\n          </div>\r\n\r\n          <div class=\"card-safe safe-body-theme\">\r\n            <span class=\"card-safe-head safe-theme\">التخزين والتداول الآمن</span>\r\n            <p class=\"card-safe-text\">يُحفظ في العبوة الأصلية مغلقة بعيد عن الحرارة الشديدة. محتاج معلومات أكتر؟ راجع\r\n              ورقة بيانات السلامة (SDS).</p>\r\n          </div>\r\n        "
  },
  {
    "id": "buildlite",
    "theme": "blue",
    "name": "Build Lite",
    "code": "12A1",
    "type_ar": "منشط قلوي ومُلين مياه",
    "raw_content": "\r\n\r\n          <div class=\"card-header hd-theme\">\r\n            <div class=\"clax-badge-wrap\">\r\n              <div class=\"clax-box\"><span>CLAX</span></div>\r\n              <div class=\"clax-divider\"></div>\r\n              <span class=\"card-prod-name\">Build Lite</span>\r\n            </div>\r\n            <span class=\"card-prod-code\">12A1</span>\r\n          </div>\r\n\r\n          <span class=\"prod-type-tag tag-theme\">منشط قلوي ومُلين مياه</span>\r\n\r\n          <div class=\"card-body\">\r\n            <div class=\"card-top-row\">\r\n\r\n              <div class=\"card-content\">\r\n                <div class=\"sec-head head-theme\">إيه هي المادة دي؟</div>\r\n                <p class=\"btext\">Clax Build Lite منشط قلوي سائل بيلين المياه. يحتوي على قلويات ومواد بتمسك الأملاح\r\n                  المعدنية. يصلح للمناطق اللي فيها مياه متوسطة أو قليلة العسر.</p>\r\n\r\n                <div class=\"sec-head head-theme\">إزاي بيشتغل؟</div>\r\n                <p class=\"btext\">بيقلل صلابة المياه وبيمنع ترسيب المنظفات على الغسيل. لو اتدمج مع المبيض بيعمل نظافة\r\n                  قوية في المستشفيات ودور الرعاية.</p>\r\n\r\n                <div class=\"sec-head head-theme\">المميزات</div>\r\n                <ul class=\"blist\">\r\n                  <li>بيحسن إزالة الأوساخ وبقع الأكل والدهون</li>\r\n                  <li>بيمنع رمادية الغسيل ويحجز الأوساخ في الماء</li>\r\n                  <li>بيمنع اصفرار الغسيل</li>\r\n                  <li>بيحسن أداء الألياف في الغسلة</li>\r\n                </ul>\r\n              </div>\r\n\r\n              <div class=\"card-icon-box\">\r\n                <svg viewBox=\"0 0 80 70\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                  <rect x=\"18\" y=\"30\" width=\"44\" height=\"32\" rx=\"3\" stroke=\"#2b52a8\" stroke-width=\"2\" fill=\"#eef4ff\" />\r\n                  <path d=\"M18 38 L40 44 L62 38\" stroke=\"#2b52a8\" stroke-width=\"1.5\" fill=\"none\" />\r\n                  <ellipse cx=\"34\" cy=\"28\" rx=\"9\" ry=\"6\" stroke=\"#2b52a8\" stroke-width=\"1.8\" fill=\"#ddeaff\" />\r\n                  <line x1=\"34\" y1=\"22\" x2=\"34\" y2=\"56\" stroke=\"#2b52a8\" stroke-width=\"1.2\" opacity=\"0.4\" />\r\n                  <ellipse cx=\"52\" cy=\"26\" rx=\"7\" ry=\"5\" stroke=\"#2b52a8\" stroke-width=\"1.5\" fill=\"#ddeaff\" />\r\n                  <path d=\"M40 6 Q36 12 36 16 Q36 21 40 21 Q44 21 44 16 Q44 12 40 6Z\" fill=\"#2b52a8\" opacity=\"0.7\" />\r\n                  <path d=\"M24 8 L24 20\" stroke=\"#2b52a8\" stroke-width=\"1.4\" fill=\"none\" stroke-linecap=\"round\"\r\n                    marker-end=\"url(#arr-blue)\" />\r\n                  <path d=\"M56 8 L56 20\" stroke=\"#2b52a8\" stroke-width=\"1.4\" fill=\"none\" stroke-linecap=\"round\"\r\n                    marker-end=\"url(#arr-blue)\" />\r\n                </svg>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"sec-head head-theme\" style=\"margin-top:10px;\">طريقة الاستخدام والجرعة</div>\r\n            <p class=\"dosage-line\">الجرعة بتتغير على حسب نوع الغسيل.</p>\r\n            <table class=\"dose-table th-theme\">\r\n              <thead>\r\n                <tr>\r\n                  <th>درجة الأوساخ</th>\r\n                  <th>الجرعة (مل/كجم)</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr>\r\n                  <td>خفيفة</td>\r\n                  <td>3 – 5</td>\r\n                </tr>\r\n                <tr>\r\n                  <td>متوسطة</td>\r\n                  <td>6 – 10</td>\r\n                </tr>\r\n                <tr>\r\n                  <td>شديدة</td>\r\n                  <td>10 – 15</td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n            <p class=\"btext\" style=\"margin-top:5px;\">إزالة الدهون بتبقى أحسن على حرارة 60-70 درجة. في مصانع الأغذية،\r\n              الشطف لازم يكون بمياه صالحة للشرب لأي قطعة بتلمس الأكل.</p>\r\n          </div>\r\n\r\n          <div class=\"tech-section\">\r\n            <div class=\"sec-head head-theme\">البيانات الفنية</div>\r\n            <table class=\"tech-table-enhanced tt-theme\">\r\n              <thead>\r\n                <tr>\r\n                  <th colspan=\"4\">البيانات الفنية</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr>\r\n                  <td class=\"lbl\">الشكل</td>\r\n                  <td class=\"val\">سائل كهرماني شفاف</td>\r\n                  <td class=\"lbl\">القلوية الكلية (% Na₂O)</td>\r\n                  <td class=\"val\">20</td>\r\n                </tr>\r\n                <tr>\r\n                  <td class=\"lbl\">الـ pH (نقي)</td>\r\n                  <td class=\"val\">13.5</td>\r\n                  <td class=\"lbl\">الكثافة (20°م)</td>\r\n                  <td class=\"val\">1.33</td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n            <p class=\"tech-note\">الأرقام مؤشرات عامة للإنتاج العادي وليست مواصفة رسمية.</p>\r\n          </div>\r\n\r\n          <div class=\"card-safe safe-body-theme\">\r\n            <span class=\"card-safe-head safe-theme\">التخزين والتداول الآمن</span>\r\n            <p class=\"card-safe-text\">يُحفظ في العبوة الأصلية مغلقة بعيد عن الحرارة الشديدة وبعيد عن أماكن تخزين الأكل.\r\n              راجع ورقة بيانات السلامة (SDS).</p>\r\n          </div>\r\n        "
  },
  {
    "id": "sonril",
    "theme": "gold",
    "name": "Sonril Ultra",
    "code": "40B1",
    "type_ar": "مبيض أكسجين للحرارة العالية",
    "raw_content": "\r\n\r\n          <div class=\"card-header hd-theme\">\r\n            <div class=\"clax-badge-wrap\">\r\n              <div class=\"clax-box\"><span>CLAX</span></div>\r\n              <div class=\"clax-divider\"></div>\r\n              <span class=\"card-prod-name\">Sonril Ultra</span>\r\n            </div>\r\n            <span class=\"card-prod-code\">40B1</span>\r\n          </div>\r\n\r\n          <span class=\"prod-type-tag tag-theme\">مبيض أكسجين للحرارة العالية</span>\r\n\r\n          <div class=\"card-body\">\r\n            <div class=\"card-top-row\">\r\n\r\n              <div class=\"card-content\">\r\n                <div class=\"sec-head head-theme\">إيه هي المادة دي؟</div>\r\n                <p class=\"btext\">Clax Sonril Ultra مزيل بقع مركز للمغاسل الكبيرة والمستشفيات. يصلح لكل أنواع الغسيل (ما\r\n                  عدا النايلون) ويُضاف في الغسلة الرئيسية على حرارة بين 70 و90 درجة.</p>\r\n\r\n                <div class=\"sec-head head-theme\">إزاي بيشتغل؟</div>\r\n                <p class=\"btext\">مبيض بالأكسجين (بيروكسيد هيدروجين) ثابت وفعال. سائل رقيق سهل الضخ. يصلح لكل الغسيل حتى\r\n                  الملون. تنبيه: بقع الدم بتتثبت مع البيروكسيد — عالج الغسيل اللي عليه دم بمنتج إنزيمي أولاً.</p>\r\n\r\n                <div class=\"sec-head head-theme\">المميزات</div>\r\n                <ul class=\"blist\">\r\n                  <li>مزيل بقع ممتاز لكل الغسيل حتى الملون</li>\r\n                  <li>سهل الجرعة</li>\r\n                  <li>بيحافظ على الغسيل لو اتستخدم صح</li>\r\n                </ul>\r\n              </div>\r\n\r\n              <div class=\"card-icon-box\">\r\n                <svg viewBox=\"0 0 80 70\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                  <rect x=\"8\" y=\"6\" width=\"64\" height=\"58\" rx=\"10\" stroke=\"#2b52a8\" stroke-width=\"2.2\" fill=\"#eef4ff\" />\r\n                  <ellipse cx=\"40\" cy=\"37\" rx=\"19\" ry=\"21\" fill=\"#2b52a8\" opacity=\"0.85\" />\r\n                  <circle cx=\"35\" cy=\"32\" r=\"5\" stroke=\"#fff\" stroke-width=\"1.5\" fill=\"none\" />\r\n                  <circle cx=\"47\" cy=\"30\" r=\"3.5\" stroke=\"#fff\" stroke-width=\"1.3\" fill=\"none\" />\r\n                  <circle cx=\"38\" cy=\"44\" r=\"3\" stroke=\"#fff\" stroke-width=\"1.2\" fill=\"none\" />\r\n                  <path d=\"M28 37 Q33 32 38 37 Q43 42 48 37 Q51 34 52 37\" stroke=\"#fff\" stroke-width=\"1.5\" fill=\"none\"\r\n                    stroke-linecap=\"round\" />\r\n                  <circle cx=\"58\" cy=\"16\" r=\"2.5\" fill=\"#c8a96e\" opacity=\"0.9\" />\r\n                  <circle cx=\"52\" cy=\"12\" r=\"1.8\" fill=\"#c8a96e\" opacity=\"0.7\" />\r\n                  <circle cx=\"20\" cy=\"18\" r=\"2\" fill=\"#c8a96e\" opacity=\"0.6\" />\r\n                </svg>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"sec-head head-theme\" style=\"margin-top:10px;\">طريقة الاستخدام والجرعة</div>\r\n            <p class=\"dosage-line\">الجرعة المناسبة: 1.7 – 3.4 مل / كجم غسيل جاف.</p>\r\n            <p class=\"note-head\">مهم جداً:</p>\r\n            <ul class=\"blist\">\r\n              <li>شغله أحسن فوق 80 درجة، والـ pH في الغسلة بين 9 و10.7.</li>\r\n              <li>حرارة عالية مع pH فوق 10.7 ممكن يتلف الألياف الطبيعية.</li>\r\n              <li>للتبييض على 60-80 درجة: pH يكون 11 – 11.5.</li>\r\n              <li>تحت 60 درجة: التبييض بيبقى ضعيف.</li>\r\n              <li>ماتستخدمش على النايلون (زي حصائر HTN).</li>\r\n            </ul>\r\n          </div>\r\n\r\n          <div class=\"tech-section\">\r\n            <div class=\"sec-head head-theme\">البيانات الفنية</div>\r\n            <table class=\"tech-table-enhanced tt-theme\">\r\n              <thead>\r\n                <tr>\r\n                  <th colspan=\"4\">البيانات الفنية</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr>\r\n                  <td class=\"lbl\">الشكل</td>\r\n                  <td class=\"val\">سائل شفاف عديم اللون</td>\r\n                  <td class=\"lbl\">الأكسجين المتاح (%)</td>\r\n                  <td class=\"val\">14.0</td>\r\n                </tr>\r\n                <tr>\r\n                  <td class=\"lbl\">الكثافة عند 20°م</td>\r\n                  <td class=\"val\">1.13</td>\r\n                  <td class=\"lbl\"></td>\r\n                  <td class=\"val\"></td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n            <p class=\"tech-note\">الأرقام مؤشرات عامة للإنتاج العادي وليست مواصفة رسمية.</p>\r\n          </div>\r\n\r\n          <div class=\"card-safe safe-body-theme\">\r\n            <span class=\"card-safe-head safe-theme\">التخزين والتداول الآمن</span>\r\n            <p class=\"card-safe-text\">يُحفظ في العبوة الأصلية مغلقة بعيد عن الحرارة الشديدة. راجع ورقة بيانات السلامة\r\n              (SDS).</p>\r\n          </div>\r\n        "
  },
  {
    "id": "neutrapur",
    "theme": "red",
    "name": "Neutrapur",
    "code": "60",
    "type_ar": "محايد حموضة للغسيل",
    "raw_content": "\r\n\r\n          <div class=\"card-header hd-theme\">\r\n            <div class=\"clax-badge-wrap\">\r\n              <div class=\"clax-box\"><span>CLAX</span></div>\r\n              <div class=\"clax-divider\"></div>\r\n              <span class=\"card-prod-name\">Neutrapur</span>\r\n            </div>\r\n            <span class=\"card-prod-code\">60</span>\r\n          </div>\r\n\r\n          <span class=\"prod-type-tag tag-theme\">محايد حموضة للغسيل</span>\r\n\r\n          <div class=\"card-body\">\r\n            <div class=\"card-top-row\">\r\n\r\n              <div class=\"card-content\">\r\n                <div class=\"sec-head head-theme\">إيه هي المادة دي؟</div>\r\n                <p class=\"btext\">Clax Neutrapur بيحيد القلوية الزيادة اللي بتفضل على الغسيل بعد الغسلة. بيتضاف في آخر\r\n                  شطفة في أي برنامج غسيل.</p>\r\n\r\n                <div class=\"sec-head head-theme\">إزاي بيشتغل؟</div>\r\n                <p class=\"btext\">بيعتمد على حمض عضوي قوي بيتفاعل مع أي قلوية زيادة على الغسيل. ومايسيبش أي ريحة وحشة على\r\n                  القماش بعد الاستخدام. يصلح مع كل منتجات دايفرسي وكل أنواع الغسيل.</p>\r\n\r\n                <div class=\"sec-head head-theme\">المميزات</div>\r\n                <ul class=\"blist\">\r\n                  <li>حمض عضوي فعال</li>\r\n                  <li>مايسيبش ريحة على الغسيل</li>\r\n                  <li>يصلح مع جميع أنواع الغسيل</li>\r\n                </ul>\r\n              </div>\r\n\r\n              <div class=\"card-icon-box\">\r\n                <svg viewBox=\"0 0 80 70\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                  <rect x=\"12\" y=\"32\" width=\"56\" height=\"30\" rx=\"3\" stroke=\"#cc2200\" stroke-width=\"2\" fill=\"#fff3f0\" />\r\n                  <path d=\"M12 40 L40 48 L68 40\" stroke=\"#cc2200\" stroke-width=\"1.5\" fill=\"none\" />\r\n                  <ellipse cx=\"30\" cy=\"30\" rx=\"10\" ry=\"7\" stroke=\"#cc2200\" stroke-width=\"1.8\" fill=\"#ffddd9\" />\r\n                  <ellipse cx=\"52\" cy=\"28\" rx=\"8\" ry=\"5.5\" stroke=\"#cc2200\" stroke-width=\"1.5\" fill=\"#ffddd9\" />\r\n                  <path d=\"M16 12 L16 24\" stroke=\"#cc2200\" stroke-width=\"1.6\" fill=\"none\" stroke-linecap=\"round\"\r\n                    marker-end=\"url(#arr-red)\" />\r\n                  <path d=\"M64 12 L64 24\" stroke=\"#cc2200\" stroke-width=\"1.6\" fill=\"none\" stroke-linecap=\"round\"\r\n                    marker-end=\"url(#arr-red)\" />\r\n                  <text x=\"40\" y=\"16\" text-anchor=\"middle\" font-size=\"10\" font-weight=\"700\" fill=\"#cc2200\"\r\n                    font-family=\"Arial\">pH</text>\r\n                </svg>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"sec-head head-theme\" style=\"margin-top:10px;\">طريقة الاستخدام والجرعة</div>\r\n            <p class=\"dosage-line\">يُضاف في آخر شطفة بماكينة الجرعات العادية.</p>\r\n            <p class=\"dosage-line\">نسبة الحموضة (pH) المطلوبة في الغسيل في النهاية: حوالي 6.5</p>\r\n            <p class=\"dosage-line\">الجرعة المناسبة: 1.5 – 4 مل / كجم غسيل جاف.</p>\r\n          </div>\r\n\r\n          <div class=\"tech-section\">\r\n            <div class=\"sec-head head-theme\">البيانات الفنية</div>\r\n            <table class=\"tech-table-enhanced tt-theme\">\r\n              <thead>\r\n                <tr>\r\n                  <th colspan=\"4\">البيانات الفنية</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr>\r\n                  <td class=\"lbl\">الشكل</td>\r\n                  <td class=\"val\">سائل شفاف عديم اللون</td>\r\n                  <td class=\"lbl\">الـ pH (نقي)</td>\r\n                  <td class=\"val\">أقل من 1</td>\r\n                </tr>\r\n                <tr>\r\n                  <td class=\"lbl\">الكثافة</td>\r\n                  <td class=\"val\">1.08 جم/مل</td>\r\n                  <td class=\"lbl\">الرائحة</td>\r\n                  <td class=\"val\">حمضية نفاذة</td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n            <p class=\"tech-note\">الأرقام مؤشرات عامة للإنتاج العادي وليست مواصفة رسمية.</p>\r\n          </div>\r\n\r\n          <div class=\"card-safe safe-body-theme\">\r\n            <span class=\"card-safe-head safe-theme\">التخزين والتداول الآمن</span>\r\n            <p class=\"card-safe-text\">يُحفظ في العبوة الأصلية مغلقة بعيد عن الحرارة الشديدة. راجع ورقة بيانات السلامة\r\n              (SDS).</p>\r\n          </div>\r\n        "
  },
  {
    "id": "neutra3in1",
    "theme": "red",
    "name": "Neutra 3in1",
    "code": "63A",
    "type_ar": "محيد قلوية + محيد كلور + مزيل صدأ",
    "raw_content": "\r\n\r\n          <div class=\"card-header hd-theme\">\r\n            <div class=\"clax-badge-wrap\">\r\n              <div class=\"clax-box\"><span>CLAX</span></div>\r\n              <div class=\"clax-divider\"></div>\r\n              <span class=\"card-prod-name\">Neutra 3in1</span>\r\n            </div>\r\n            <span class=\"card-prod-code\">63A</span>\r\n          </div>\r\n\r\n          <span class=\"prod-type-tag tag-theme\">محيد قلوية + محيد كلور + مزيل صدأ</span>\r\n\r\n          <div class=\"card-body\">\r\n            <div class=\"card-top-row\">\r\n\r\n              <div class=\"card-content\">\r\n                <div class=\"sec-head head-theme\">إيه هي المادة دي؟</div>\r\n                <p class=\"btext\">Clax Neutra 3in1 سائل حمضي بيشتغل في آخر الغسلة بثلاث وظائف في نفس الوقت: بيحيد القلوية\r\n                  الزيادة، بيحيد الكلور الزيادة، وبيشيل آثار الحديد والصدأ. يحتوي على حمض عضوي سهل التحلل.</p>\r\n\r\n                <div class=\"sec-head head-theme\">المميزات</div>\r\n                <ul class=\"blist\">\r\n                  <li>مش محتاج شطفة زيادة عشان تنزل الـ pH صح</li>\r\n                  <li>بيحمي الغسيل من الاصفرار بسبب الكلور الزيادة</li>\r\n                  <li>بيشيل ريحة الكلور من الغسيل</li>\r\n                  <li>بيمنع اصفرار الغسيل بسبب الحديد في المياه</li>\r\n                </ul>\r\n\r\n                <div class=\"sec-head head-theme\">بيصلح لإيه؟</div>\r\n                <ul class=\"blist\">\r\n                  <li>تحييد القلوية الزيادة على الغسيل</li>\r\n                  <li>تحييد الكلور الزيادة</li>\r\n                  <li>مادة بتمسك الحديد وتمنع ترسيبه</li>\r\n                </ul>\r\n              </div>\r\n\r\n              <div class=\"card-icon-box\">\r\n                <svg viewBox=\"0 0 80 70\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                  <circle cx=\"40\" cy=\"36\" r=\"28\" stroke=\"#cc2200\" stroke-width=\"2.2\" fill=\"#fff3f0\" />\r\n                  <circle cx=\"40\" cy=\"36\" r=\"18\" stroke=\"#cc2200\" stroke-width=\"1.5\" fill=\"#ffddd9\" />\r\n                  <circle cx=\"32\" cy=\"29\" r=\"6\" stroke=\"#cc2200\" stroke-width=\"1.5\" fill=\"#fff\" />\r\n                  <text x=\"32\" y=\"32\" text-anchor=\"middle\" font-size=\"7\" font-weight=\"800\" fill=\"#cc2200\"\r\n                    font-family=\"Arial\">pH</text>\r\n                  <circle cx=\"48\" cy=\"29\" r=\"6\" stroke=\"#cc2200\" stroke-width=\"1.5\" fill=\"#fff\" />\r\n                  <text x=\"48\" y=\"32\" text-anchor=\"middle\" font-size=\"7\" font-weight=\"800\" fill=\"#cc2200\"\r\n                    font-family=\"Arial\">Cl</text>\r\n                  <circle cx=\"40\" cy=\"44\" r=\"6\" stroke=\"#cc2200\" stroke-width=\"1.5\" fill=\"#fff\" />\r\n                  <text x=\"40\" y=\"47\" text-anchor=\"middle\" font-size=\"7\" font-weight=\"800\" fill=\"#cc2200\"\r\n                    font-family=\"Arial\">Fe</text>\r\n                  <text x=\"40\" y=\"10\" text-anchor=\"middle\" font-size=\"9\" font-weight=\"800\" fill=\"#cc2200\"\r\n                    font-family=\"Arial\">3 in 1</text>\r\n                </svg>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"sec-head head-theme\" style=\"margin-top:10px;\">طريقة الاستخدام</div>\r\n            <p class=\"dosage-line\">يُضاف في آخر شطفة بعد خلوص الغسلة الرئيسية.</p>\r\n            <p class=\"dosage-line\">الـ pH المطلوب في الغسيل في النهاية: بين 6 و6.5</p>\r\n            <p class=\"note-head\">تنبيهات مهمة:</p>\r\n            <ul class=\"blist\">\r\n              <li>المنتج ده في حالته المركزة يأثر على الحديد والجلد — لا تخزنه في أواني حديد ولا تضخه بخراطيم معدنية.\r\n              </li>\r\n              <li>احتفظ بيه في وعاء مغلق دايماً.</li>\r\n            </ul>\r\n          </div>\r\n\r\n          <div class=\"tech-section\">\r\n            <div class=\"sec-head head-theme\">البيانات الفنية</div>\r\n            <table class=\"tech-table-enhanced tt-theme\">\r\n              <thead>\r\n                <tr>\r\n                  <th colspan=\"4\">البيانات الفنية</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr>\r\n                  <td class=\"lbl\">الشكل</td>\r\n                  <td class=\"val\">سائل شفاف</td>\r\n                  <td class=\"lbl\">الـ pH (محلول 1%)</td>\r\n                  <td class=\"val\">1.9 – 2.5</td>\r\n                </tr>\r\n                <tr>\r\n                  <td class=\"lbl\">الكثافة</td>\r\n                  <td class=\"val\">1.10 – 1.14</td>\r\n                  <td class=\"lbl\"></td>\r\n                  <td class=\"val\"></td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n            <p class=\"tech-note\">الأرقام مؤشرات عامة للإنتاج العادي وليست مواصفة رسمية.</p>\r\n          </div>\r\n\r\n          <div class=\"card-safe safe-body-theme\">\r\n            <span class=\"card-safe-head safe-theme\">التخزين والتداول الآمن</span>\r\n            <p class=\"card-safe-text\">يُحفظ في العبوة الأصلية مغلقة بعيد عن الحرارة الشديدة. لا تحطه في أواني معدنية ولا\r\n              تضخه بخراطيم حديد. راجع ورقة بيانات السلامة (SDS).</p>\r\n          </div>\r\n        "
  },
  {
    "id": "clax200",
    "theme": "green",
    "name": "200",
    "code": "24A1",
    "type_ar": "منشط تنظيف مركز (يكسر الدهون)",
    "raw_content": "\r\n\r\n          <div class=\"card-header hd-theme\">\r\n            <div class=\"clax-badge-wrap\">\r\n              <div class=\"clax-box\"><span>CLAX</span></div>\r\n              <div class=\"clax-divider\"></div>\r\n              <span class=\"card-prod-name\">200</span>\r\n            </div>\r\n            <span class=\"card-prod-code\">24A1</span>\r\n          </div>\r\n\r\n          <span class=\"prod-type-tag tag-theme\">منشط تنظيف مركز (يكسر الدهون)</span>\r\n\r\n          <div class=\"card-body\">\r\n            <div class=\"card-top-row\">\r\n\r\n              <div class=\"card-content\">\r\n                <div class=\"sec-head head-theme\">إيه هي المادة دي؟</div>\r\n                <p class=\"btext\">Clax 200 منشط سائل مركز بيحسن إزالة الدهون والزيوت من الغسيل. فيه مواد سطحية ومُبيض\r\n                  ضوئي (أوبتيكال برايتنر). بيتستخدم مع منشطات القلوية أو منظفات الغسلة الرئيسية.</p>\r\n\r\n                <div class=\"sec-head head-theme\">إزاي بيشتغل؟</div>\r\n                <p class=\"btext\">بيشتت الدهون والزيوت ويمنع رجوعها على الغسيل. بيشتغل كويس على الغسيل الأبيض الثقيل زي\r\n                  ملابس الشغل القطن والبوليستر وبياضات المطاعم. المُبيض الضوئي ثابت حتى مع الكلور.</p>\r\n\r\n                <div class=\"sec-head head-theme\">المميزات</div>\r\n                <ul class=\"blist\">\r\n                  <li>ممتاز لإزالة بقع الدهون والزيوت</li>\r\n                  <li>ما بيعملش رغوة زيادة — مناسب للغسالات الصناعية</li>\r\n                  <li>بيحافظ على بياض الغسيل (مُبيض ضوئي)</li>\r\n                </ul>\r\n              </div>\r\n\r\n              <div class=\"card-icon-box\">\r\n                <svg viewBox=\"0 0 80 70\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                  <rect x=\"8\" y=\"6\" width=\"64\" height=\"58\" rx=\"10\" stroke=\"#2a7a2a\" stroke-width=\"2.2\" fill=\"#edfaed\" />\r\n                  <circle cx=\"40\" cy=\"37\" r=\"20\" stroke=\"#2a7a2a\" stroke-width=\"2\" fill=\"#c8ecc8\" />\r\n                  <circle cx=\"34\" cy=\"31\" r=\"6\" stroke=\"#fff\" stroke-width=\"1.8\" fill=\"none\" />\r\n                  <circle cx=\"47\" cy=\"29\" r=\"4\" stroke=\"#fff\" stroke-width=\"1.5\" fill=\"none\" />\r\n                  <circle cx=\"38\" cy=\"45\" r=\"3.5\" stroke=\"#fff\" stroke-width=\"1.3\" fill=\"none\" />\r\n                  <path d=\"M30 38 Q33 33 36 38 Q39 43 42 38 Q45 33 48 38\" stroke=\"#fff\" stroke-width=\"1.5\" fill=\"none\"\r\n                    stroke-linecap=\"round\" />\r\n                </svg>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"sec-head head-theme\" style=\"margin-top:10px;\">طريقة الاستخدام والجرعة</div>\r\n            <p class=\"dosage-line\">الجرعة بتتغير على حسب نوع الغسيل.</p>\r\n            <table class=\"dose-table th-theme\">\r\n              <thead>\r\n                <tr>\r\n                  <th>درجة الأوساخ</th>\r\n                  <th>الجرعة (مل/كجم)</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr>\r\n                  <td>خفيفة</td>\r\n                  <td>0.5 – 2.0</td>\r\n                </tr>\r\n                <tr>\r\n                  <td>متوسطة</td>\r\n                  <td>2.0 – 5.0</td>\r\n                </tr>\r\n                <tr>\r\n                  <td>شديدة</td>\r\n                  <td>3.0 – 6.0</td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n          </div>\r\n\r\n          <div class=\"tech-section\">\r\n            <div class=\"sec-head head-theme\">البيانات الفنية</div>\r\n            <table class=\"tech-table-enhanced tt-theme\">\r\n              <thead>\r\n                <tr>\r\n                  <th colspan=\"4\">البيانات الفنية</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr>\r\n                  <td class=\"lbl\">الشكل</td>\r\n                  <td class=\"val\">سائل شفاف عديم اللون</td>\r\n                  <td class=\"lbl\">الـ pH (محلول 1%)</td>\r\n                  <td class=\"val\">6.9</td>\r\n                </tr>\r\n                <tr>\r\n                  <td class=\"lbl\">الكثافة (20°م)</td>\r\n                  <td class=\"val\">0.97</td>\r\n                  <td class=\"lbl\">اللزوجة (mPa.s / 25°م)</td>\r\n                  <td class=\"val\">60</td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n            <p class=\"tech-note\">الأرقام مؤشرات عامة للإنتاج العادي وليست مواصفة رسمية.</p>\r\n          </div>\r\n\r\n          <div class=\"card-safe safe-body-theme\">\r\n            <span class=\"card-safe-head safe-theme\">التخزين والتداول الآمن</span>\r\n            <p class=\"card-safe-text\">يُحفظ في العبوة الأصلية مغلقة بعيد عن الحرارة الشديدة. راجع ورقة بيانات السلامة\r\n              (SDS).</p>\r\n          </div>\r\n        "
  },
