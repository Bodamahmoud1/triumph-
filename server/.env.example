# Copy to .env and fill in real values. Never commit .env.

PORT=3000
NODE_ENV=development

# Turso — https://turso.tech (Database URL + auth token)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Auth — use a long random JWT_SECRET in production
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Comma-separated allowed origins (required on Vercel / Render)
CORS_ORIGIN=https://triumph-laundry.vercel.app,http://localhost:3000
